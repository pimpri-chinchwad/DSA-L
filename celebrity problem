
class Solution {
  public:
    int celebrity(vector<vector<int>>& mat) {
        bool celebrity;
        vector<int> celebrityRowList,finalCelebrity;
        
        for (int i=0; i<mat.size(); i++){
            celebrity=true;
            for(int j=0; j<mat.size(); j++){ 
                if(mat[j][i]==0){
                    celebrity=false;
                    break;
                }
            }
            
            if(celebrity){celebrityRowList.push(i);}
        }
        
        for i : celebrityRowList{
            for(int j=0; j<mat.size();j++){
                if(i==j){continue;}
                else if(mat[i][j]==1){celebrity=false;break;}
            }
            if(celebrity){finalCelebrity.push(i);}
        }
    }
};
